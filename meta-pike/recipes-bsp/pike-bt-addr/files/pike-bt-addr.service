[Unit]
Description=Give the MT6630 Bluetooth its factory address and RF calibration
DefaultDependencies=no
After=local-fs.target
Before=android-init.service bluetooth.service sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/pike-bt-addr

[Install]
WantedBy=sysinit.target
