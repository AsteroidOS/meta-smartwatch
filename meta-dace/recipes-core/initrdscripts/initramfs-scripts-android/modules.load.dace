# qnoc-monaco: ESSENTIAL and NOW INCLUDED (it was blacklisted during
# bring-up). It is the ICC provider that msm_drm (qcom,sde-reg-bus) and the
# apps-smmu (via interconnects) depend on. It must be loaded BEFORE msm_drm:
# msm_smmu_probe() (driver of smmu_sde_unsec_cb, inside msm_drm.ko) calls
# iommu_get_domain_for_dev() and if there is no domain it returns -EINVAL -NOT
# -EPROBE_DEFER!-, so if the apps-smmu is not up yet, the component is never
# added and msm_drm_bind() does not create /dev/dri (no display).
# The hard reset to EDL that forced its removal is solved: arm-smmu honors
# qcom,skip-init (arm-smmu-skip-init.patch) and also marks the firmware SMR/S2CR
# table as in use (if it was not marked, Linux overwrote the eMMC one ->
# 'mmc0: ADMA error' -> EDL).
qnoc-monaco.ko
icc-rpm.ko
qnoc-qos-rpm.ko
qrtr.ko
# qrtr-smd bridges the qrtr bus onto SMD/glink so ADSP services (audio APM/PDR,
# WLFW) become reachable; without it the monaco sound card never goes ONLINE.
# Only safe to autoload now that AGM's boot-time mixer sweep no longer
# hard-resets the SoC (poisoned cs40l26 codec fixed by cs40l26-codec.0 binding).
qrtr-smd.ko
msm_drm.ko
msm_kgsl.ko
qseecom_dlkm.ko
smcinvoke_dlkm.ko
google-extcon-usb-shim.ko
gvotable.ko
logbuffer.ko
# ── VIA1: minimal charger/BMS chain (staged load from init.sh) ──
# The culprit of the hang was the google-* chain (aurora fuel gauges that do
# not exist on the T5). We let init.sh load them in stages (STAGE n) to verify:
#   qti-qbg-main (STOCK mobvoi, charger IIO provider)
# → qpnp-smblite-main (aurora build, charger). gvotable/logbuffer (deps)
# already go above in the normal modprobe.
# They are NOT loaded here in the bulk modprobe (the init STAGE window loads them).
# google-bms/battery/charger/sw5100_bms: aurora-only, hang on T5 → out.
# qpnp-smblite-main.ko
# qti-qbg-main.ko
nanohub.ko
touch_nt38350.ko
cl_dsp.ko
cl_dsp-debugfs.ko
input-cs40l26-i2c.ko
snd-soc-cs40l26.ko
