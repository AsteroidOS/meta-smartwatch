From: Cristodcgomez <cristo.c.mc@gmail.com>
Subject: [PATCH] iommu/arm-smmu: honor "qcom,skip-init" (dace bring-up)

The google-eos kernel dropped support for the downstream "qcom,skip-init"
property that the stock Mobvoi 5.15 and the monaco-gki 5.4 implement. The T5
DT marks apps-smmu@0xc600000 with it: the secure firmware has already
programmed the SMMU and Linux must not rewrite SMRn/S2CRn/CBn, or the SoC
hard-resets to EDL as soon as qnoc-monaco registers the ICC nodes and
unblocks the probe.

smmu->smrs[]/s2crs[] start empty, so the guard alone is not enough:
arm_smmu_find_sme() would reuse entries the firmware owns and the eMMC loses
its translation ("mmc0: ADMA error"). arm_smmu_mark_hw_smrs() reads the live
table and reserves those entries and their context banks.

Upstream-Status: Inappropriate [dace bring-up]
Signed-off-by: Cristodcgomez <cristo.c.mc@gmail.com>
---
diff --git a/drivers/iommu/arm/arm-smmu/arm-smmu.c b/drivers/iommu/arm/arm-smmu/arm-smmu.c
index b506737..d0df26e 100644
--- a/drivers/iommu/arm/arm-smmu/arm-smmu.c
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu.c
@@ -91,6 +91,7 @@ struct arm_smmu_option_prop {
 
 static struct arm_smmu_option_prop arm_smmu_options[] = {
 	{ ARM_SMMU_OPT_FATAL_ASF, "qcom,fatal-asf" },
+	{ ARM_SMMU_OPT_SKIP_INIT, "qcom,skip-init" },
 	{ ARM_SMMU_OPT_3LVL_TABLES, "qcom,use-3-lvl-tables" },
 	{ ARM_SMMU_OPT_NO_ASID_RETENTION, "qcom,no-asid-retention" },
 	{ ARM_SMMU_OPT_DISABLE_ATOS, "qcom,disable-atos" },
@@ -2831,6 +2832,7 @@ static void arm_smmu_device_reset(struct arm_smmu_device *smmu)
 	reg = arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_sGFSR);
 	arm_smmu_gr0_write(smmu, ARM_SMMU_GR0_sGFSR, reg);
 
+	if (!(smmu->options & ARM_SMMU_OPT_SKIP_INIT)) {
 #if defined CONFIG_QTI_QUIN_GVM
 	/*
 	 * Reset stream mapping groups for unused sme's: Initial values mark all SMRn as
@@ -2860,6 +2862,7 @@ static void arm_smmu_device_reset(struct arm_smmu_device *smmu)
 		arm_smmu_cb_write(smmu, i, ARM_SMMU_CB_FSR, ARM_SMMU_FSR_FAULT);
 	}
 #endif
+	}
 
 	/* Invalidate the TLB, just in case */
 	arm_smmu_gr0_write(smmu, ARM_SMMU_GR0_TLBIALLH, QCOM_DUMMY_VAL);
@@ -3476,6 +3479,47 @@ err_reset_platform_ops: __maybe_unused;
 	return err;
 }
 
+/*
+ * Reserve the SMRs/S2CRs (and their context banks) that the firmware already
+ * programmed, so Linux does not hand them to another master.
+ */
+static void arm_smmu_mark_hw_smrs(struct arm_smmu_device *smmu)
+{
+	u32 smr, s2cr;
+	int i;
+
+	if (!smmu->smrs || !smmu->s2crs)
+		return;
+
+	for (i = 0; i < smmu->num_mapping_groups; ++i) {
+		smr = arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_SMR(i));
+		s2cr = arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_S2CR(i));
+
+		if (smmu->features & ARM_SMMU_FEAT_EXIDS) {
+			if (!FIELD_GET(ARM_SMMU_S2CR_EXIDVALID, s2cr))
+				continue;
+		} else {
+			if (!FIELD_GET(ARM_SMMU_SMR_VALID, smr))
+				continue;
+		}
+
+		smmu->smrs[i].id = FIELD_GET(ARM_SMMU_SMR_ID, smr);
+		smmu->smrs[i].mask = FIELD_GET(ARM_SMMU_SMR_MASK, smr);
+		smmu->smrs[i].valid = true;
+		smmu->smrs[i].pinned = true;
+
+		smmu->s2crs[i].group = NULL;
+		smmu->s2crs[i].count = 0;
+		smmu->s2crs[i].type = FIELD_GET(ARM_SMMU_S2CR_TYPE, s2cr);
+		smmu->s2crs[i].privcfg = FIELD_GET(ARM_SMMU_S2CR_PRIVCFG, s2cr);
+		smmu->s2crs[i].cbndx = FIELD_GET(ARM_SMMU_S2CR_CBNDX, s2cr);
+		smmu->s2crs[i].pinned = true;
+
+		if (smmu->s2crs[i].type == S2CR_TYPE_TRANS)
+			bitmap_set(smmu->context_map, smmu->s2crs[i].cbndx, 1);
+	}
+}
+
 static int arm_smmu_device_probe(struct platform_device *pdev)
 {
 	struct resource *res;
@@ -3606,6 +3650,8 @@ static int arm_smmu_device_probe(struct platform_device *pdev)
 		goto out_power_off;
 	smmu->phys_addr = res->start;
 	parse_driver_options(smmu);
+	if (smmu->options & ARM_SMMU_OPT_SKIP_INIT)
+		arm_smmu_mark_hw_smrs(smmu);
 	err = arm_smmu_handoff_cbs(smmu);
 	if (err)
 		goto out_power_off;
diff --git a/drivers/iommu/arm/arm-smmu/arm-smmu.h b/drivers/iommu/arm/arm-smmu/arm-smmu.h
index 5bb6e5b..1427a91 100644
--- a/drivers/iommu/arm/arm-smmu/arm-smmu.h
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu.h
@@ -376,6 +376,7 @@ struct arm_smmu_device {
 	u32				features;
 
 #define ARM_SMMU_OPT_FATAL_ASF		(1 << 0)
+#define ARM_SMMU_OPT_SKIP_INIT		(1 << 1)
 #define ARM_SMMU_OPT_3LVL_TABLES	(1 << 2)
 #define ARM_SMMU_OPT_NO_ASID_RETENTION	(1 << 3)
 #define ARM_SMMU_OPT_DISABLE_ATOS	(1 << 4)
