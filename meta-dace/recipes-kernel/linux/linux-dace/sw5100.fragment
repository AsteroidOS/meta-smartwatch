CONFIG_GOOGLE_VOTABLE=m
CONFIG_GOOGLE_LOGBUFFER=m
CONFIG_I2C_CHARDEV=m
CONFIG_QCOM_RAMDUMP=m
CONFIG_REGMAP_QTI_DEBUGFS_ALLOW_WRITE=y

# cdsp-loader (drivers/soc/qcom/qdsp6v2/cdsp-loader.c) registers
# /sys/kernel/boot_cdsp/boot. Android's init.qti.write.sh polls that
# path with a ~90s timeout; without the driver, the oneshot service
# eats 92s in the background. With the driver, the write goes through
# PAS to the CDSP subsystem (or fails fast on missing firmware).
CONFIG_MSM_CDSP_LOADER=m

CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_CONSOLE_SLEEP=y
CONFIG_HW_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_LDISC_AUTOLOAD=y

# Kernel-owned USB debug channel.
# g_serial (=y) registers its gadget and CLAIMS the UDC at boot: the configfs
# adb finds the UDC busy ("couldn't find an available UDC") and does not go out
# to the bus as 18d1:d002. For adb we disable it: the adb gadget (configfs/ffs)
# will take the UDC. The ttyGS0 console comes back later via the configfs acm
# function or via adb shell.
# CONFIG_USB_G_SERIAL is not set
CONFIG_U_SERIAL_CONSOLE=y

# gcc-monaco/gdsc fail with "Failed to register GCC clocks" when
# CONFIG_REGULATOR_PROXY_CONSUMER is set: the GDSC proxy-consumer path
# does regulator_get(proxy) on an RPM regulator that is not up when the
# clock controllers probe (-517, never resolves → no GCC clocks → dead
# display + broken eMMC bus-scale → boot hang). With it unset the proxy
# call is a no-op stub and GCC clocks register directly, matching the
# stock device kernel. (proxy-consumer.ko is then not built.)
# CONFIG_REGULATOR_PROXY_CONSUMER is not set

# Namespaces — required by LXC for Halium.
# monaco_GKI.config trims these (watches are RAM-constrained);
# NAMESPACES/UTS/NET already =y so only these three are missing.
# CONFIG_IPC_NS depends on CONFIG_SYSVIPC, which monaco_GKI ALSO trims
# (# CONFIG_SYSVIPC is not set) — without this, olddefconfig silently
# drops IPC_NS. SYSVIPC is a hard prerequisite of the (justified)
# IPC_NS, and Android/LXC use SysV IPC anyway.
CONFIG_SYSVIPC=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y

# LSM primary: AppArmor, matching UBPorts's running kernel on this hardware
# (lsm=capability,apparmor). apparmor precedes selinux in CONFIG_LSM, so the
# exclusive-LSM logic activates apparmor and never initialises selinux: selinuxfs
# isn't registered and the Android container sees getenforce=Disabled boots
# fine that way (vndservicemanager, apexd-bootstrap, and the display HALs all
# run with selinux disabled).
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
CONFIG_SECURITY_PATH=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,apparmor,selinux,smack,tomoyo,bpf"

# monaco_GKI.config sets CONFIG_QPNP_SMBLITE=m, but the kernel-tree
# build of that driver fails — its smblite-shim.h includes
# <misc/gvotable.h> which lives in the out-of-tree google-modules/bms
# (Google builds qpnp-smblite as an external module via EXT_MODULES so
# the gvotable header search path is set up via Module.symvers chaining).
# Override to "not set" so the in-tree kernel build doesn't try this;
# the driver is only buildable via the linux-dace-modules EXT_MODULES
# path once we add google-modules/bms (gvotable) and the kernel
# drivers/power/supply/qcom as out-of-tree modules.
# CONFIG_QCOM_POWER_SUPPLY is not set
# CONFIG_QPNP_SMBLITE is not set
# CONFIG_QTI_QBG is not set
# ─── SLATE (Mobvoi coprocessor) ─────────────────────────────────────────────
# They were disabled during bring-up. They are enabled as MODULES (=m) because
# the overlay of OUR variant (Monaco IDP V1.0) creates their DT nodes
# (slate-spi, slate-daemon, slatecom-rpmsg, slate-events-bridge, slate-rsb,
# slate-mobvoirpc, slatetouch-rpmsg) and because:
#   * the VENDOR touch driver depends on slate_mobvoi_rpc and
#     slate_events_bridge (and the 'slatetouch-rpmsg' channel exists in the DT),
#   * MSM_SEB literally says it receives the slate BUTTON EVENTS
#     (the button/wheel that does not work),
# so it is very likely that the slate powers/enables the touch and manages the
# keys. =m (not =y) so they can be loaded by hand and the effect observed.
CONFIG_MSM_SEB=m
CONFIG_MSM_SEB_RPMSG=m
CONFIG_MSM_SLATECOM=m
CONFIG_MSM_SLATECOM_EVENT=m
CONFIG_MSM_SLATECOM_INTERFACE=m
CONFIG_MSM_SLATECOM_RPMSG=m
CONFIG_MSM_SLATERSB=m
CONFIG_MSM_SLATERSB_RPMSG=m
CONFIG_QCOM_RPROC_SLATE=m

CONFIG_RPMSG_QCOM_GLINK_SLATECOM=m

# Boot splash (psplash) via the bootloader continuous-splash buffer.
#
# psplash needs a legacy /dev/fb0. The SDE DRM driver deliberately has no fbdev
# emulation, and on this command-mode panel the in-kernel drm_fb_helper modeset
# is gated by SDE cont_splash and never lights the panel anyway. Instead, the
# bootloader's cont_splash buffer (reserved splash_region) is *already* being
# scanned out to the panel during boot, so qcom-cont-splash-fb (a tiny generic
# fbdev driver, bound to an injected "qcom,cont-splash-fb" DT node) exposes that
# live region as /dev/fb0 — psplash writes land in the buffer the display is
# scanning and appear immediately, no DRM/modeset/kickoff.
#
# CONFIG_FB for the fbdev core; FRAMEBUFFER_CONSOLE stays off (EXPERT=y gates it
# off) so nothing else draws on the splash. CONFIG_DRM_FBDEV_EMULATION is forced
# OFF: its Kconfig default is 'y', and with it on the stock msm_drv.c references
# msm_fbdev_init()/free() which this tree does not provide -> insmod fails.
CONFIG_FB=y
CONFIG_FB_QCOM_CONT_SPLASH=y
# CONFIG_DRM_FBDEV_EMULATION is not set

# Virtual HCI device — backs /dev/vhci, which bluebinder writes HCI
# packets to so the kernel BlueZ stack sees them as if they came from a
# real controller. The QCA BT chip on this watch is owned by the Android
# vendor.bluetooth-1-0-qti HAL inside the LXC container; bluebinder
# proxies binder→/dev/vhci to expose it to BlueZ on the host side. With
# this off, /dev/vhci doesn't exist and bluebinder has nowhere to write.
CONFIG_BT_HCIVHCI=m

# ─── Internal watchdog (dace bring-up) ───
# CONFIG_WATCHDOG_CORE=y + CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y make the
# kernel reboot if the boot does not "complete" (USB clk/regulator chain). On
# dace with the incomplete chain, the WDT kills the kernel at ~8-15s after
# loading the modules (init alive -> black -> EDL). For bring-up we disable
# them: the kernel must stay alive even if the USB chain does not complete.
# (The ABL watch is not touched; this is Qualcomm's internal kernel WDT.)
# CONFIG_WATCHDOG_CORE is not set
# CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED is not set

# ─── STACKPROTECTOR: compatibility with stock vendor modules ───
# The prebuilt .ko's from the stock vendor_boot (Mobvoi) were built with
# STACKPROTECTOR_STRONG and need __stack_chk_fail exported (only with
# CONFIG_STACKPROTECTOR=y). The other missing CFI symbols
# (__cfi_slowpath_diag, __ubsan_handle_cfi_check_fail_abort) are covered by
# dace-stock-stubs.patch.
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# ─── WQ_WATCHDOG (smblite charger workqueue watchdog) ───
# CONFIG_WQ_WATCHDOG=y panics the kernel if the charger workqueue
# (qpnp-smblite) freezes waiting for VDD_CX (which does not arrive on dace
# because the RPM chain does not complete). It is the trigger of the panic at
# ~8-15s (init alive -> reboot). Off for bring-up.
# CONFIG_WQ_WATCHDOG is not set
# CONFIG_QCOM_SOC_WATCHDOG is not set

# ── TOUCH: Zinitix via the vendor driver ─────────────────────────────
# The touch is served by the stock Zinitix driver (dace-vendor-touch), so the
# mainline driver must stay off: it would claim 1-0020 and block the vendor
# probe. The vendor driver is loaded from dace-lxc-hal-start.sh after the HALs.
# CONFIG_TOUCHSCREEN_ZINITIX is not set

# ── SHADOW CALL STACK (compatibility with stock vendor .ko's) ────────────────
# The stock .ko's (Mobvoi msm-5.15 g7f9d6c16b5cd) were built with SCS: they
# save x30 via x18 (str x30,[x18],#8).
# NOTE: this line does NOT take effect (verified 2026-09-15: the final .config
# does not have CONFIG_SHADOW_CALL_STACK and a freshly built module of ours
# comes out with 0 SCS instructions; Kconfig discards it in this
# configuration). That is why the vendor .ko's are NOPed in the
# dace-vendor-touch recipe (see its files/README.txt and patch-stock-module.py).
# The line is kept in case it can be enabled some day: then the .ko's would
# have to be baked WITHOUT patching.
CONFIG_SHADOW_CALL_STACK=y

# ── POWER MANAGEMENT: autosleep for MCE (2026-09-23) ─────────────────────────
# MEASURED: the watch NEVER suspends (`/sys/power/suspend_stats/success` = 0
# after 21 h of uptime). Root cause: MCE (mce/libwakelock.c:lwl_probe()) looks
# for a supported suspend model and finds none:
#   * `echo on > /sys/power/state` -> EINVAL (early-suspend does not exist in 5.15)
#   * /sys/power/autosleep does NOT exist (CONFIG_PM_AUTOSLEEP off, same as the
#     Mobvoi stock and aurora) -> lwl_probe() returns SUSPEND_TYPE_NONE
#   * result: mdy_stm_start_fb_suspend() writes NOTHING and the SoC stays in
#     WFI/C3 forever (mce_mux re-activates ~1/1.9 s, 40 617 times).
# In stock Android suspend is triggered by the framework (PowerManager writes
# "mem" to /sys/power/state); on AsteroidOS there is no framework -> the native
# mechanism is MCE/Sailfish autosleep (writes "mem" to autosleep when the
# framebuffer turns off). With PM_AUTOSLEEP=y, lwl_probe() returns
# SUSPEND_TYPE_AUTO and MCE suspends again. It is the ONLY kernel change that
# power management requires.
CONFIG_PM_AUTOSLEEP=y
