[Unit]
Description=Keep Aurora Wi-Fi associated across system suspend
After=systemd-modules-load.service
Before=connman.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'i=0; while [ ! -e /sys/class/ieee80211/phy0 ] && [ "$i" -lt 60 ]; do sleep 1; i=$((i + 1)); done; test -e /sys/class/ieee80211/phy0; /usr/sbin/iw phy phy0 wowlan enable disconnect'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
